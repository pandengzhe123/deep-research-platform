# ============================================================
# 生产部署配置模板
#
# 用法：复制为根目录 .env（.gitignore 已忽略 .env，不会入库）并填入真实值。
# 本地开发不需要这个文件 —— docker-compose.yml 里 ${VAR:-默认值} 的默认值
# 就是本地开发用的，直接 docker compose up 即可。
#
# ⚠️ 本仓库是公开的：任何写进代码/配置文件并提交的密钥都等于公开密钥。
#    所有真实密钥只能放这里（.env）或 agent/.env，两者都不入库。
# ============================================================

# ---- 必填 ①：JWT 签发密钥（至少 32 字节）----
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# 留空的后果：网关每次启动随机生成一把密钥 → 重启后所有人被踢下线（不会不安全，但不可用）
# 绝不能用的值：仓库里出现过的任何字符串（例如 deepresearch-dev-secret-key-min-32bytes!!）
JWT_SECRET=

# ---- 必填 ②：PostgreSQL 密码 ----
# ⚠️ 该变量只在数据卷「首次初始化」时生效。
#    若 pgdata 卷已存在，改这里不会改掉真实密码，需进容器执行：
#      docker exec -it deepresearch-postgres-1 psql -U postgres -c "ALTER USER postgres WITH PASSWORD '新密码';"
POSTGRES_PASSWORD=

# ---- 必填 ③：Redis 密码 ----
# 未授权 Redis 是自动化挖矿木马的头号扫描目标，公网上一旦开放 6379 几分钟内就会被入侵。
# 本 compose 已把 6379 绑到回环地址，但密码仍然必须设（纵深防御）。
REDIS_PASSWORD=

# ---- 必填 ④：注册邀请码 ----
# 留空 = 完全关闭注册（演示站的推荐值）。
# 为什么默认关：公网可自由注册 = 把你的付费 API 额度开放给全世界 —— 注册完就能跑
# 研究，而单次 L4 实测消耗 232 万 prompt token。需要临时开账号时再设一个随机串。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(16))"
REGISTER_INVITE_CODE=

# ---- 成本熔断 ----
# 全站 / 单用户 每日研究次数上限（agent 侧执行，见 agent/src/researcher/server.py）
GLOBAL_DAILY_RESEARCH_LIMIT=100
USER_DAILY_RESEARCH_LIMIT=20
# Redis 不可用时是否拒绝研究。默认 true（fail-closed）：
# 每分钟限流降级只是「这一分钟没人管」，每日配额降级却是「成本无上限」，代价差几个量级。
# 若你的站点可用性优先于成本可控，改成 false。
QUOTA_FAIL_CLOSED=true
# 每用户每分钟研究次数上限
RATE_LIMIT_PER_MINUTE=10

# ---- 访问控制 ----
# 认证端点每 IP 每分钟尝试上限（挡字典撞库与批量注册）
AUTH_RATE_LIMIT_PER_MINUTE=20
# 是否允许非管理员使用 Level 4。L4 单次实测 232 万 prompt token，默认关闭。
ALLOW_LEVEL4_NON_ADMIN=false

# ---- 输入体积上限（三层：nginx client_max_body_size / 网关 / agent）----
MAX_UPLOAD_BYTES=20971520
MAX_IN_MEMORY_BYTES=20971520
MAX_COMPRESS_CHARS=400000

# ---- 端口 ----
# 唯一暴露到公网的端口。生产用 80；配好 TLS 后改 443 并把证书挂进 frontend 容器
FRONTEND_PORT=80
# PG / Redis 默认只绑 127.0.0.1，一般无需修改。需要本机工具直连时保持默认即可
PG_PORT=5432
REDIS_PORT=6379

# ---- 日志级别 ----
# 生产用 INFO。DEBUG 会打印 SQL 之外的内部细节，不建议在公网服务上长期开启
LOG_LEVEL=INFO

# ============================================================
# 另外还要准备 agent/.env（同样不入库，模板见 agent/.env.example）：
#   DEEPSEEK_API_KEY / TAVILY_API_KEY / DASHSCOPE_API_KEY
# 上线前建议在三个平台各建一把「新 key 并设置消费上限」，
# 本地开发用的旧 key 不要直接搬上服务器 —— 旧 key 已在本地明文使用过。
# ============================================================
